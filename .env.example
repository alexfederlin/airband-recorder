# Copy to .env and fill in your values. Never commit .env: it holds your
# Rdio Scanner API key. After a change, run: docker compose up -d

# Time zone for clip times and day folders
TZ=Europe/Berlin

# Optional services: "rdio" also starts Rdio Scanner (live feed, mobile apps)
#COMPOSE_PROFILES=rdio

# --- Recorder ---
# Sound card; list names with: arecord -L | grep plughw
DEVICE=plughw:CARD=Device,DEV=0
# Rdio Scanner API key, with COMPOSE_PROFILES=rdio; empty = archive only, no upload
KEY=
# Monitored frequency in Hz
FREQ=119700000
# Audio level that counts as a transmission, seconds of silence that end a
# clip, and shortest clip kept
#THRESHOLD=2%
#HANG=2.0
#MIN_LEN=0.5
# Rdio Scanner system and talkgroup IDs
#SYSTEM=1
#TALKGROUP=1

# --- Where data lives ---
# Recordings with transcripts; default ./data/archive. The systemd install
# used ~/scanner-archive (give the full path, ~ doesn't work here).
#ARCHIVE_DIR=/home/alex/scanner-archive
# Rdio Scanner database folder; default ./data/rdio-scanner
#RDIO_DATA=./data/rdio-scanner

# --- Timeline ---
# Transcription language; "auto" if German traffic is common
WHISPER_LANG=en
#WHISPER_THREADS=4
# Days of recordings to keep; 0 keeps everything
#KEEP_DAYS=30
# Speech model, built into the image: tiny is faster, small more accurate.
# After changing it, run: docker compose up -d --build
#WHISPER_MODEL_NAME=base
# Or a model file in ./models, e.g. the ATC fine-tune converted by the test
# set (copy it from testset/models/). Overrides WHISPER_MODEL_NAME.
#WHISPER_MODEL=/extra-models/ggml-jlvdoorn--whisper-small-atco2-asr.bin
# Prompt for Whisper (try variants in the test set's Prompt lab first). Unset =
# the built-in ATC prompt, none = no prompt. Use double quotes.
#WHISPER_PROMPT="Schönhagen Tower, D-EABC, report downwind runway 25, QNH 1013."
# 1 = after a model, language or prompt change, older transcripts are redone in the
# background (new clips first); 0 = keep them as they are
#RETRANSCRIBE=1

# --- Aircraft nearby (ADS-B) ---
# With the airport's position, the timeline asks free ADS-B networks which
# aircraft are near when a transmission is recorded, shows them with it, and
# puts their callsigns into Whisper's prompt. Example: Mönchengladbach (EDLN).
#AIRPORT_LAT=51.2303
#AIRPORT_LON=6.5047
# Aircraft within this distance (km) and below this altitude (ft) count;
# aircraft on the ground only within ADSB_GROUND_KM of the airport
#ADSB_RADIUS_KM=20
#ADSB_MAX_ALT_FT=5000
#ADSB_GROUND_KM=3
# Networks to ask, all at once: adsb.lol, adsb.fi, opensky
#ADSB_SOURCES=adsb.lol,adsb.fi,opensky
# A local readsb/tar1090 once there is an SDR stick, asked first
#ADSB_LOCAL_URL=http://adsb.local/tar1090/data/aircraft.json
